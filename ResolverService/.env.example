# Copia como ResolverService/.env. No versionar el archivo real.
RESOLVER_DOMAIN=audio.example.com
DIEGOMUSIC_API_TOKEN=REEMPLAZAR_CON_OPENSSL_RAND_HEX_32
SESSION_TTL_SECONDS=14400
RESOLVE_TIMEOUT_SECONDS=35
UPSTREAM_TIMEOUT_SECONDS=30

# Caché de resoluciones en memoria: 500 pistas durante hasta 3 horas.
RESOLUTION_CACHE_MAX_ENTRIES=500
RESOLUTION_CACHE_TTL_SECONDS=10800
RESOLUTION_CACHE_SAFETY_MARGIN_SECONDS=300

# Caché persistente M4A: 5 GiB totales y 256 MiB máximo por pista.
# Usa 0 en AUDIO_CACHE_MAX_BYTES para desactivarla.
AUDIO_CACHE_MAX_BYTES=5368709120
AUDIO_CACHE_MAX_FILE_BYTES=268435456

# Opcional para contenido que requiera una identidad autorizada en el VPS.
# YTDLP_COOKIES_FILE=/run/secrets/cookies.txt
