// Copia este archivo como Secrets.xcconfig o ejecuta scripts/generate-secrets.sh.
// No incluyas el archivo real en control de versiones.
// Puedes incluir múltiples claves separadas por comas para rotar en caso de cuota agotada:
// YOUTUBE_DATA_KEY = CLAVE1, CLAVE2, CLAVE3
YOUTUBE_DATA_KEY = REEMPLAZAR_LOCALMENTE
AUDIO_RESOLVER_BASE_URL = https:/$()/audio.example.com
AUDIO_RESOLVER_API_TOKEN = REEMPLAZAR_CON_UN_TOKEN_ALEATORIO_DE_32_CARACTERES_O_MAS
